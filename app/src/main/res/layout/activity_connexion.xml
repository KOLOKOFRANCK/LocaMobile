<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <EditText android:id="@+id/champCourriel"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Courriel" android:inputType="textEmailAddress" />

    <EditText android:id="@+id/champMotDePasse"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:hint="Mot de passe" android:inputType="textPassword" />

    <Button android:id="@+id/boutonSeConnecter"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Se connecter" />

    <TextView android:id="@+id/resultat"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="16dp" android:textSize="16sp" />
</LinearLayout>