<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView android:id="@+id/etat"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textColor="#B00020" android:textSize="16sp" />

    <TextView android:id="@+id/detailTitre"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="22sp" android:textStyle="bold" />

    <TextView android:id="@+id/detailVille"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" />

    <TextView android:id="@+id/detailPrix"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" />

    <TextView android:id="@+id/detailVoyageurs"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" />

    <TextView android:id="@+id/detailProprietaire"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:textSize="16sp" />
</LinearLayout>